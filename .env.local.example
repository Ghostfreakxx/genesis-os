# Copy this file to .env.local and fill in the keys you want to enable.
# Both are optional — the app runs fine without either, using fallback
# content instead of live data. Never commit your real .env.local file.

# Live headlines for the World Signal Feed, AI SITREP source material, and
# Conflict Tracker zone briefings. Without it, those fall back to a small
# set of static "Genesis fallback" articles.
# Get a free key (100 requests/day) at https://gnews.io
GNEWS_API_KEY=

# Powers the AI SITREP panel, which has Claude synthesize a short briefing
# from the current sector's live headlines. Without it, the panel shows
# "AI briefing unavailable" instead of faking a response.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
